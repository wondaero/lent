{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false },
    { "source": "/:page(login|circulation|loans|books|members|posts|print|settings)", "destination": "/admin/:page", "permanent": false },
    { "source": "/:page(login|circulation|loans|books|members|posts|print|settings)/:rest+", "destination": "/admin/:page/:rest+", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
